<section class="auth-shell">
  <div class="auth-card">
    <div class="auth-brand">
      <span class="brand-mark">P</span>
      <div>
        <p class="eyebrow">Private ledger</p>
        <h1>Pennyworth</h1>
      </div>
    </div>

    <form method="post" action="/login" class="auth-form">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
      <h2>Sign in</h2>
      <% if (error) { %><p class="error"><%= error %></p><% } %>
      <label>
        Email
        <input type="email" name="email" autocomplete="username" required autofocus>
      </label>
      <label>
        Password
        <input type="password" name="password" autocomplete="current-password" required>
      </label>
      <button type="submit">Sign in</button>
      <details class="auth-recovery">
        <summary>Forgot your password?</summary>
        <p><%= t("If another administrator can sign in, ask them to reset your password from") %> <strong><%= t("Settings") %> → <%= t("Users") %></strong>. <%= t("You will receive a temporary password to change after signing in.") %></p>
        <p>If you are the only administrator, run this command from the Pennyworth server console, then enter the new password twice:</p>
        <code><%= "docker exec -it APP_CONTAINER npm run auth:reset-password -- --email YOUR_EMAIL" %></code>
        <p>For Podman, replace docker with podman.</p>
      </details>
    </form>
  </div>
</section>
