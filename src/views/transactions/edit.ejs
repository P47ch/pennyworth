<% const formValue = typeof draftField === 'function' ? draftField : (_name, fallback) => fallback;
   const formSelected = typeof draftSelected === 'function' ? draftSelected : (_name, _option, fallback) => Boolean(fallback); %>
<section class="page-heading">
  <div>
    <p class="eyebrow">Ledger entry</p>
    <h1>Edit transaction</h1>
  </div>
  <a class="button-link" href="/transactions">Back to transactions</a>
</section>

<section class="panel">
  <div class="panel-heading">
    <h2><%= transaction.description || "Transaction" %></h2>
    <span class="badge badge-<%= transaction.type %>"><%= typeLabel(transaction.type) %></span>
  </div>
  <% if (error) { %><p class="error"><%= t(error) %></p><% } %>
  <% if (transaction.feeForTransactionId || transaction.feeTransaction) { %>
    <p class="muted"><%= t('This entry is linked to a top-up fee. Its type, date, and accounts must stay together; amounts and categories can be corrected separately.') %></p>
    <a class="action-link" href="/transactions/<%= transaction.feeForTransactionId || transaction.feeTransaction.id %>/edit"><%= t(transaction.feeForTransactionId ? 'View linked transfer' : 'View linked fee') %></a>
  <% } %>
  <form method="post" action="/transactions/<%= transaction.id %>" class="form-grid transaction-form" data-transaction-form data-validation="transaction">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
    <label>
      <span>Type</span>
      <select name="type" required data-transaction-type>
        <% for (const type of transactionTypes) { %>
          <option value="<%= type %>" <%= (formSelected('type', type, (transaction.type === type ? "selected" : ""))) ? 'selected' : '' %>><%= typeLabel(type) %></option>
        <% } %>
      </select>
    </label>
    <label>
      <span>Date</span>
      <input type="date" name="date" value="<%= formValue('date', transaction.date.toISOString().slice(0, 10)) %>" required>
    </label>
    <label>
      <span>Amount</span>
      <input name="amount" inputmode="decimal" value="<%= formValue('amount', (transaction.amountMinor / 100).toFixed(2)) %>" required pattern="\s*[0-9]+([.,][0-9]{1,2})?\s*">
    </label>
    <label>
      <span data-source-account-text>Account</span>
      <select name="sourceAccountId" required>
        <option value="" <%= (formSelected('sourceAccountId', "", false)) ? 'selected' : '' %>>Choose account</option>
        <% for (const account of accounts) { %>
          <option value="<%= account.id %>" <%= (formSelected('sourceAccountId', account.id, (transaction.sourceAccountId === account.id ? "selected" : ""))) ? 'selected' : '' %>><%= account.name %></option>
        <% } %>
      </select>
    </label>
    <label data-transfer-only>
      <span>Destination account</span>
      <select name="destinationAccountId">
        <option value="" <%= (formSelected('destinationAccountId', "", false)) ? 'selected' : '' %>>Only for transfers</option>
        <% for (const account of accounts) { %>
          <option value="<%= account.id %>" <%= (formSelected('destinationAccountId', account.id, (transaction.destinationAccountId === account.id ? "selected" : ""))) ? 'selected' : '' %>><%= account.name %></option>
        <% } %>
      </select>
    </label>
    <label data-category-field>
      <span>Category</span>
      <select name="categoryId">
        <option value="" <%= (formSelected('categoryId', "", false)) ? 'selected' : '' %>>None</option>
        <% for (const category of categories) { %>
          <option value="<%= category.id %>" data-category-type="<%= category.type %>" <%= (formSelected('categoryId', category.id, (transaction.categoryId === category.id ? "selected" : ""))) ? 'selected' : '' %>><%= category.name %></option>
        <% } %>
      </select>
    </label>
    <fieldset class="full-width">
      <legend>Tags</legend>
      <div class="checkbox-list">
        <% const selectedTagIds = new Set(transaction.tags.map((item) => item.tagId)); %>
        <% for (const tag of tags) { %>
          <label>
            <input type="checkbox" name="tagIds" value="<%= tag.id %>" <%= formSelected('tagIds', tag.id, (selectedTagIds.has(tag.id) ? "checked" : "")) ? 'checked' : '' %>>
            <%= tag.name %>
          </label>
        <% } %>
      </div>
    </fieldset>
    <label>
      Description
      <input name="description" value="<%= formValue('description', transaction.description || "") %>">
    </label>
    <label class="full-width">
      Notes
      <textarea name="notes" rows="3"><%= formValue('notes', transaction.notes || "" ) %></textarea>
    </label>
    <button type="submit">Save changes</button>
  </form>
</section>
