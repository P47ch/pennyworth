<section class="page-heading">
  <div>
    <p class="eyebrow">Automation</p>
    <div class="rules-title-row">
      <h1>Rules</h1>
      <%- include("../partials/rules-help.ejs") %>
    </div>
  </div>
</section>

<section class="panel">
  <div class="panel-heading">
    <h2>Add rule</h2>
    <span class="muted">Match transaction text to a category</span>
  </div>
  <% if (error) { %><p class="error"><%= t(error) %></p><% } %>
  <form method="post" action="/rules" class="form-grid rules-form">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
    <label>
      Name
      <input name="name" value="<%= form.name %>" required>
    </label>
    <label>
      Match text
      <input name="matchText" value="<%= form.matchText %>" placeholder="netflix, spotify, amazon prime" aria-describedby="rule-match-hint" required>
      <small class="muted" id="rule-match-hint">Separate alternatives with commas. Any matching term applies the rule; spaces within a term form a phrase.</small>
    </label>
    <label>
      Category
      <select name="categoryId" required>
        <option value="">Choose category</option>
        <% for (const category of categories) { %>
          <option value="<%= category.id %>" <%= form.categoryId === category.id ? "selected" : "" %>><%= category.name %></option>
        <% } %>
      </select>
    </label>
    <fieldset class="full-width">
      <legend>Tags to add</legend>
      <div class="checkbox-list">
        <% for (const tag of tags) { %>
          <label>
            <input type="checkbox" name="tagIds" value="<%= tag.id %>" <%= form.tagIds.includes(tag.id) ? "checked" : "" %>>
            <%= tag.name %>
          </label>
        <% } %>
      </div>
    </fieldset>
    <label class="checkbox-row">
      <input type="checkbox" name="isActive" <%= form.isActive ? "checked" : "" %>>
      Active
    </label>
    <button type="submit">Add rule</button>
  </form>
</section>

<section class="panel">
  <div class="panel-heading">
    <h2>Rule list</h2>
    <div class="panel-actions">
      <a href="/rules/apply">Apply to existing</a>
      <span class="muted"><%= rules.length %> rules</span>
    </div>
  </div>
  <% if (rules.length === 0) { %>
    <div class="empty-state">
      <strong>No rules yet</strong>
      <p>Add rules for merchants or recurring text you want to categorize later.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Order</th>
            <th>Name</th>
            <th>Match text</th>
            <th>Category</th>
            <th>Tags</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% for (let index = 0; index < rules.length; index += 1) { %>
            <% const rule = rules[index]; %>
            <tr>
              <td data-label="Order">
                <div class="row-actions">
                  <form method="post" action="/rules/<%= rule.id %>/move">
                    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                    <input type="hidden" name="direction" value="up">
                    <button class="button-secondary" type="submit" <%= index === 0 ? "disabled" : "" %>>Up</button>
                  </form>
                  <form method="post" action="/rules/<%= rule.id %>/move">
                    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                    <input type="hidden" name="direction" value="down">
                    <button class="button-secondary" type="submit" <%= index === rules.length - 1 ? "disabled" : "" %>>Down</button>
                  </form>
                </div>
              </td>
              <td data-label="Name"><strong><%= rule.name %></strong></td>
              <td data-label="Match text"><%= rule.matchText %></td>
              <td data-label="Category"><%- categoryLabel(rule.category) %></td>
              <td data-label="Tags">
                <% if (rule.tags.length === 0) { %>
                  -
                <% } else { %>
                  <div class="tag-list compact">
                    <% for (const item of rule.tags) { %>
                      <span class="tag tag-with-color"><%- colorSwatch(item.tag.color) %><%= item.tag.name %></span>
                    <% } %>
                  </div>
                <% } %>
              </td>
              <td data-label="Status">
                <span class="badge <%= rule.isActive ? "badge-active" : "badge-muted" %>"><%= rule.isActive ? "active" : "inactive" %></span>
              </td>
              <td data-label="Actions">
                <div class="row-actions">
                  <a class="action-link" href="/rules/<%= rule.id %>/edit">Edit</a>
                  <form method="post" action="/rules/<%= rule.id %>/active">
                    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                    <input type="hidden" name="isActive" value="<%= rule.isActive ? 'false' : 'true' %>">
                    <button class="button-secondary" type="submit" aria-label="<%= t(rule.isActive ? 'Disable rule: {name}' : 'Enable rule: {name}', { name: rule.name }) %>"><%= t(rule.isActive ? "Disable" : "Enable") %></button>
                  </form>
                  <form method="post" action="/rules/<%= rule.id %>/delete">
                    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                    <button class="button-danger" type="submit">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
