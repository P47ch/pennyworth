<section class="panel empty-state" role="alert" aria-labelledby="error-heading">
  <p class="eyebrow">Error <%= statusCode %></p>
  <h1 id="error-heading"><%= heading %></h1>
  <p><%= message %></p>
  <p class="muted">Request ID: <code><%= requestId %></code></p>
  <a class="button-link" href="/">Return to dashboard</a>
</section>
