<section class="page-heading dashboard-heading">
  <div>
    <p class="eyebrow">Overview</p>
    <h1>Dashboard</h1>
  </div>
  <a class="button-link" href="/transactions"><%- icon("plus") %> <%= t("Add transaction") %></a>
</section>

<div class="dashboard-widgets">
  <section class="dashboard-hero" aria-label="Financial overview">
    <article class="summary-card summary-card-primary net-worth-widget">
      <span>Net worth</span>
      <strong><%= formatMoney(summary.totalBalanceMinor) %></strong>
      <dl class="net-worth-breakdown">
        <div><dt>Cash</dt><dd><%= formatMoney(summary.totalCashBalanceMinor) %></dd></div>
        <div><dt>Investments</dt><dd><%= formatMoney(summary.investmentSummary.totalInvestmentValueMinor) %></dd></div>
      </dl>
    </article>

    <article class="summary-card cashflow-widget">
      <div class="widget-heading">
        <div><span>This month</span><small>Income and spending</small></div>
        <a href="/statistics">View statistics</a>
      </div>
      <dl class="cashflow-summary">
        <div><dt>Income</dt><dd class="money-income"><%= formatMoney(summary.incomeMinor) %></dd></div>
        <div><dt>Expenses</dt><dd class="money-expense"><%= formatMoney(summary.expensesMinor) %></dd></div>
        <div><dt>Net cashflow</dt><dd><%= formatMoney(summary.netCashflowMinor) %></dd></div>
      </dl>
    </article>
  </section>

  <% if (summary.budgetAlerts.length > 0 || summary.recurringDue.length > 0) { %>
    <section class="panel attention-widget" aria-labelledby="attention-heading">
      <div class="panel-heading">
        <div><p class="eyebrow">Review</p><h2 id="attention-heading">Needs attention</h2></div>
      </div>
      <div class="attention-list">
        <% for (const budget of summary.budgetAlerts) { %>
          <a class="attention-item <%= budget.isOverBudget ? "is-urgent" : "" %>" href="/budgets">
            <span class="attention-marker" aria-hidden="true"></span>
            <span><strong><%- categoryLabel({ name: budget.categoryName, color: budget.categoryColor, icon: budget.categoryIcon }) %></strong><small><%= Math.round(budget.percentUsed * 100) %>% of budget used</small></span>
            <strong><%= formatMoney(budget.spentMinor) %> / <%= formatMoney(budget.amountMinor) %></strong>
          </a>
        <% } %>
        <% for (const item of summary.recurringDue) { %>
          <a class="attention-item" href="/recurring">
            <span class="attention-marker attention-marker-recurring" aria-hidden="true"></span>
            <span><strong><%= item.name %></strong><small>Due <%= item.nextDate.toISOString().slice(0, 10) %> · <%= item.type %></small></span>
            <strong><%= formatMoney(item.amountMinor, item.sourceAccount?.currency || primaryCurrency) %></strong>
          </a>
        <% } %>
      </div>
    </section>
  <% } %>

  <section class="panel recent-widget" aria-labelledby="recent-heading">
    <div class="panel-heading"><h2 id="recent-heading">Recent transactions</h2><a href="/transactions">View all</a></div>
    <% if (summary.recentTransactions.length === 0) { %>
      <div class="empty-state compact-empty-state"><strong>No transactions yet</strong><p>Add your first transaction to start building the dashboard.</p></div>
    <% } else { %>
      <div class="transaction-list dashboard-transaction-list">
        <% for (const transaction of summary.recentTransactions) { %>
          <div class="transaction-item">
            <div>
              <span class="badge badge-<%= transaction.type %>"><%= transaction.type %></span>
              <strong>
                <% if (transaction.description) { %>
                  <%= transaction.description %>
                <% } else if (transaction.category) { %>
                  <%- categoryLabel(transaction.category) %>
                <% } else { %>
                  Transaction
                <% } %>
              </strong>
              <small>
                <%= transaction.date.toISOString().slice(0, 10) %> ·
                <% if (transaction.type === "transfer") { %>
                  <%= transaction.sourceAccount?.name || "-" %> to <%= transaction.destinationAccount?.name || "-" %>
                <% } else { %>
                  <%= transaction.sourceAccount?.name || "-" %>
                <% } %>
              </small>
            </div>
            <strong><%= formatMoney(transaction.amountMinor, transaction.sourceAccount?.currency || primaryCurrency) %></strong>
          </div>
        <% } %>
      </div>
    <% } %>
  </section>

  <section class="dashboard-detail-grid">
    <article class="panel spending-widget">
      <div class="panel-heading"><h2>Spending by category</h2><a href="/statistics">Explore</a></div>
      <% if (summary.spendingByCategory.length === 0) { %>
        <div class="empty-state compact-empty-state"><strong>No expenses yet</strong><p>Category spending will appear here.</p></div>
      <% } else { %>
        <div class="bar-list">
          <% const visibleCategories = summary.spendingByCategory.slice(0, 5); %>
          <% const maxCategory = Math.max(...visibleCategories.map((row) => row.amountMinor)); %>
          <% for (const row of visibleCategories) { %>
            <div class="bar-row">
              <div class="bar-row-top"><%- categoryLabel(row) %><strong><%= formatMoney(row.amountMinor) %></strong></div>
              <progress class="bar-track" max="<%= maxCategory %>" value="<%= row.amountMinor %>" aria-label="<%= row.name %> spending"></progress>
            </div>
          <% } %>
        </div>
      <% } %>
    </article>

    <article class="panel accounts-widget">
      <div class="panel-heading"><h2>Account balances</h2><a href="/accounts">View all</a></div>
      <% if (summary.accounts.length === 0) { %>
        <div class="empty-state compact-empty-state"><strong>No accounts yet</strong><p>Create an account to start tracking balances.</p></div>
      <% } else { %>
        <div class="list-stack dashboard-account-list">
          <% for (const account of summary.accounts.slice(0, 4)) { %>
            <div class="list-row">
              <div><strong><%= account.name %></strong><span><%= account.type.replaceAll("_", " ") %> · <%= account.currency %></span></div>
              <strong><%= formatMoney(account.currentBalanceMinor, account.currency) %></strong>
            </div>
          <% } %>
        </div>
      <% } %>
    </article>
  </section>
</div>
