<section class="page-heading"><div><p class="eyebrow">Templates</p><div class="rules-title-row"><h1>Edit recurring</h1><%- include('../partials/recurring-help.ejs') %></div></div><a class="button-link" href="/recurring">Back to recurring</a></section>
<section class="panel">
  <div class="panel-heading"><h2><%= recurring.name %></h2><span class="badge <%= recurring.isActive ? 'badge-active' : 'badge-muted' %>"><%= t(recurring.isActive ? 'Active' : 'Inactive') %></span></div>
  <% if (error) { %><p class="error" role="alert"><%= t(error) %></p><% } %>
  <form method="post" action="/recurring/<%= recurring.id %>" class="form-grid transaction-form" data-transaction-form data-recurring-form>
    <%- include('form.ejs', { submitLabel: 'Save changes' }) %>
  </form>
</section>
