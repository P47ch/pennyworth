<section class="page-heading"><div><p class="eyebrow">Templates</p><div class="rules-title-row"><h1>Recurring</h1><%- include('../partials/recurring-help.ejs') %></div></div></section>
<section class="panel">
  <div class="panel-heading"><h2>Add recurring transaction</h2><span class="muted">Scheduled templates, confirmed manually</span></div>
  <% if (error) { %><p class="error" role="alert"><%= t(error) %></p><% } %>
  <form method="post" action="/recurring" class="form-grid transaction-form" data-transaction-form data-recurring-form>
    <%- include('form.ejs', { submitLabel: 'Add recurring' }) %>
  </form>
</section>
<section class="panel">
  <div class="panel-heading"><h2>Recurring list</h2><span class="muted"><%= recurringTransactions.length %> templates</span></div>
  <% if (recurringTransactions.length === 0) { %><div class="empty-state"><strong>No recurring templates yet</strong><p>Add rent, salary, subscriptions, or transfers you want to generate manually.</p></div>
  <% } else { %>
    <div class="table-wrap"><table>
      <thead><tr><th>Name</th><th>Next date</th><th>Type</th><th>Account</th><th>Amount</th><th>Fee</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody><% for (const item of recurringTransactions) { %><tr>
        <td data-label="Name"><strong><%= item.name %></strong><br><small class="muted"><%= t(recurringFrequencyLabels[item.frequency]) %></small></td>
        <td data-label="Next date"><%= item.nextDate.toISOString().slice(0, 10) %></td>
        <td data-label="Type"><span class="badge badge-<%= item.type %>"><%= typeLabel(item.type) %></span></td>
        <td data-label="Account"><%= item.sourceAccount?.name || '-' %><% if (item.type === 'transfer') { %> → <%= item.destinationAccount?.name || '-' %><% } %><% if (item.category) { %><br><%- categoryLabel(item.category) %><% } %></td>
        <td data-label="Amount" class="numeric"><% if (item.amountMode === 'target_balance') { %><span><%= t('Target balance') %></span><br><%= formatMoney(item.targetBalanceMinor) %><% } else { %><%= formatMoney(item.amountMinor) %><% } %></td>
        <td data-label="Fee"><% if (item.feeAmountMinor > 0) { %><%= formatMoney(item.feeAmountMinor) %><br><small><%= t(item.feeAccount === 'source' ? 'Source account' : 'Destination account') %></small><% } else { %>—<% } %></td>
        <td data-label="Status"><span class="badge <%= item.isActive ? 'badge-active' : 'badge-muted' %>"><%= t(item.isActive ? 'Active' : 'Inactive') %></span></td>
        <td data-label="Actions"><div class="row-actions">
          <% if (item.isActive) { %><a class="action-link" href="/recurring/<%= item.id %>/preview"><%= t('Preview') %></a><% } %>
          <a class="action-link" href="/recurring/<%= item.id %>/edit">Edit</a>
          <form method="post" action="/recurring/<%= item.id %>/delete"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><button class="action-link button-danger" type="submit">Delete</button></form>
        </div></td>
      </tr><% } %></tbody>
    </table></div>
  <% } %>
</section>
