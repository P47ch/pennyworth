<% const formValue = typeof draftField === 'function' ? draftField : (_name, fallback) => fallback;
   const formSelected = typeof draftSelected === 'function' ? draftSelected : (_name, _option, fallback) => Boolean(fallback); %>
<section class="page-heading">
  <div>
    <p class="eyebrow">Investments</p>
    <h1>Edit asset</h1>
  </div>
  <a class="button-link" href="/assets">Back to assets</a>
</section>

<section class="panel">
  <div class="panel-heading">
    <h2><%= asset.symbol %></h2>
    <span class="badge <%= asset.isActive ? "badge-active" : "badge-muted" %>"><%= asset.isActive ? "active" : "inactive" %></span>
  </div>
  <% if (error) { %><p class="error"><%= t(error) %></p><% } %>
  <form method="post" action="/assets/<%= asset.id %>" class="form-grid" data-validation="asset">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
    <label>
      Symbol
      <input name="symbol" value="<%= formValue('symbol', asset.symbol) %>" required pattern="\s*\S[\s\S]*">
    </label>
    <label>
      Name
      <input name="name" value="<%= formValue('name', asset.name) %>" required pattern="\s*\S[\s\S]*">
    </label>
    <label>
      Type
      <select name="type" required>
        <% for (const type of assetTypes) { %>
          <option value="<%= type %>" <%= (formSelected('type', type, (asset.type === type ? "selected" : ""))) ? 'selected' : '' %>><%= typeLabel(type) %></option>
        <% } %>
      </select>
    </label>
    <label>
      Currency
      <input name="currency" value="<%= formValue('currency', asset.currency) %>" maxlength="3" readonly required pattern="[A-Za-z]{3}">
    </label>
    <label class="checkbox-row">
      <input type="checkbox" name="isActive" <%= formSelected('isActive', "on", (asset.isActive ? "checked" : "")) ? 'checked' : '' %>>
      Active
    </label>
    <button type="submit">Save changes</button>
  </form>
</section>
