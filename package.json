{
  "name": "pennyworth",
  "version": "0.8.0-alpha.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "test": "vitest run",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "test:typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "audit:a11y": "node scripts/a11y-audit.mjs",
    "test:a11y": "npm run audit:a11y",
    "wiki:lint": "node scripts/wiki-lint.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:init-admin": "node dist/scripts/ensure-admin.js",
    "auth:reset-password": "node dist/scripts/reset-password.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:performance": "tsx scripts/performance-seed.ts",
    "benchmark:performance": "tsx scripts/performance-benchmark.ts",
    "benchmark:bulk": "tsx scripts/performance-bulk-benchmark.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^11.1.0",
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "ejs": "^3.1.10",
    "fastify": "^5.3.3",
    "lucide-static": "^1.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.15.29",
    "axe-core": "^4.12.1",
    "prisma": "^6.12.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
